  {
    "name": "payment_vct_control",
    "mandate": "payment",
    "open": {
      "vct": "mandate.payment.open.1",
      "constraints": [
        {
          "type": "payment.amount_range",
          "currency": "USD",
          "max": 5000,
          "min": 100
        }
      ],
      "cnf": {
        "jwk": {
          "kty": "EC",
          "crv": "P-256",
          "x": "x",
          "y": "y"
        }
      }
    },
    "closed": {
      "vct": "mandate.payment.1",
      "transaction_id": "tx_1",
      "payee": {
        "id": "s-1",
        "name": "Shop"
      },
      "payment_amount": {
        "amount": 1000,
        "currency": "USD"
      },
      "payment_instrument": {
        "id": "pi-1",
        "type": "credit"
      }
    },
    "expect": "accept",
    "ap2Outcome": "accept",
    "rule": "Correct vct on both mandates; control for the vct negatives below.",
    "cite": "docs/ap2/payment_mandate.md \u00a7Type; docs/ap2/specification.md \u00a7Mandate Versioning"
  },
